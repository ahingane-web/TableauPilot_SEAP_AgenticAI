{
  "name": "tableaupilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "TableauPilot AI — Agentic AI Copilot for Tableau Cloud Web Authoring",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:studio": "mastra dev",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "harness": "tsx scripts/generateSample.ts",
    "setup:hyper": "python3 -m venv .venv-hyper && .venv-hyper/bin/python -m pip install --upgrade pip && .venv-hyper/bin/python -m pip install -r scripts/hyper/requirements.txt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@hono/node-server": "^1.14.0",
    "@mastra/core": "^1.63.2",
    "@mastra/libsql": "^1.22.2",
    "@mastra/loggers": "^1.3.0",
    "@mastra/memory": "^1.28.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "mastra": "^1.27.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
