# =============================================================
# TableauPilot AI — Environment Configuration (PLACEHOLDERS ONLY)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# No secret values belong in this file.
# =============================================================

# ---------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------
# Which provider the model layer resolves: "anthropic" (via gateway) or "openrouter".
LLM_PROVIDER=anthropic
# Model id used for the TableauPilot agent (Anthropic model name).
LLM_MODEL=claude-opus-4-8

# ---------------------------------------------------------------
# Anthropic Gateway (Anthropic-compatible endpoint)
# ---------------------------------------------------------------
# Base URL of the Anthropic-compatible gateway. Do NOT include a trailing /v1.
ANTHROPIC_BASE_URL=https://your-anthropic-gateway.example.com

# ONE of the following auth mechanisms is required for the anthropic provider:
#   1. Static key:
# ANTHROPIC_API_KEY=sk-ant-...
#   2. Key helper command (printed token is captured at runtime, never logged):
# ANTHROPIC_API_KEY_HELPER=/path/to/auth-helper command args

# Optional corporate/self-signed CA bundle used when calling the gateway.
# ANTHROPIC_CA_CERT=/path/to/corporate-ca-bundle.pem

# ---------------------------------------------------------------
# OpenRouter (fallback provider, OpenAI-compatible)
# ---------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional override; defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------
# Tableau Cloud
# ---------------------------------------------------------------
# Target Tableau REST API version (e.g. 3.24). Used for all REST calls.
TABLEAU_API_VERSION=3.24
# Tableau version label (informational).
TABLEAU_VERSION=2026.1
#
# NOTE: Per-user Tableau credentials (PAT + Connected App secret) are NOT stored
# here. They are entered in the app and held in the PER-USER, PIN-ENCRYPTED VAULT.
# The optional defaults below are for LOCAL testing ONLY; leave blank in shared configs.
#
# TABLEAU_CLOUD_URL=https://10ax.online.tableau.com
# TABLEAU_SITE_CONTENT_URL=your-site
# TABLEAU_PAT_NAME=
# TABLEAU_PAT_SECRET=
#
# Tableau Connected App (Direct Trust) — used ONLY to mint short-lived JWTs so the
# embedded Web Authoring iframe loads without a separate Tableau login.
# Like the PAT, the SECRET_VALUE is stored per-user in the encrypted vault, not here.
# TABLEAU_CONNECTED_APP_CLIENT_ID=
# TABLEAU_CONNECTED_APP_SECRET_ID=
# TABLEAU_CONNECTED_APP_SECRET_VALUE=

# ---------------------------------------------------------------
# Credential Vault (per-user, 6-digit PIN)
# ---------------------------------------------------------------
# REQUIRED server-side pepper mixed into the PIN key derivation so a 6-digit PIN
# is not brute-forceable from the on-disk vault alone. Use a long random string.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_PEPPER=replace-with-a-long-random-secret
# Directory for the encrypted vault + session storage (git-ignored).
DATA_PATH=./data
# Max failed PIN attempts before temporary lockout.
VAULT_MAX_ATTEMPTS=5
# Lockout window in seconds after too many failed attempts.
VAULT_LOCKOUT_SECONDS=300
# Server session lifetime in seconds (decrypted creds live only in memory).
SESSION_TTL_SECONDS=3600

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
# Port for the backend API (Hono) server.
API_PORT=4000
# Port for the Vite web UI dev server.
WEB_PORT=5173
# Comma-separated allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173
# Logging verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
